# Debian 13 still ships SQLite 3.46.1, which contains the upstream WAL-reset
# corruption bug. Build a pinned shared library for the runtime image instead
# of relying on a distro backport that trixie does not currently provide.
# See #70480 and https://sqlite.org/wal.html#walresetbug.
# Pinned by the multi-arch index digest: uv and node already come from pm's
# sha-verified lock, and a tag alone would let the base drift under them.

FROM debian:trixie-20261020@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308 AS sqlite_build
ARG SQLITE_AUTOCONF_VERSION=3530400
ARG SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    (curl -fsSL --retry 1 --retry-all-errors --connect-timeout 15 --max-time 60 \
        -o /tmp/sqlite.tar.gz \
        "https://sqlite.org/2026/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz" || \
     curl -fsSL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 120 \
        -o /tmp/sqlite.tar.gz \
        "https://sources.buildroot.net/sqlite/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz") && \
    printf '%s  %s\n' "${SQLITE_SHA256}" /tmp/sqlite.tar.gz > /tmp/sqlite.sha256 && \
    sha256sum -c /tmp/sqlite.sha256 && \
    tar -xzf /tmp/sqlite.tar.gz -C /tmp && \
    cd "/tmp/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}" && \
    CFLAGS="-O2 \
        -DSQLITE_ENABLE_FTS3 \
        -DSQLITE_ENABLE_FTS3_PARENTHESIS \
        -DSQLITE_ENABLE_FTS4 \
        -DSQLITE_ENABLE_FTS5 \
        -DSQLITE_ENABLE_RTREE \
        -DSQLITE_ENABLE_GEOPOLY \
        -DSQLITE_ENABLE_COLUMN_METADATA \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY \
        -DSQLITE_ENABLE_DBSTAT_VTAB \
        -DSQLITE_ENABLE_DBPAGE_VTAB \
        -DSQLITE_ENABLE_MATH_FUNCTIONS \
        -DSQLITE_ENABLE_PREUPDATE_HOOK \
        -DSQLITE_ENABLE_SESSION \
        -DSQLITE_SECURE_DELETE \
        -DSQLITE_THREADSAFE=1 \
        -DSQLITE_MAX_VARIABLE_NUMBER=250000" \
        ./configure --prefix=/opt/sqlite-fixed --disable-static && \
    make -j"$(nproc)" && \
    make install

# AG-UI owns its process: no s6, gateway, desktop, Node or dashboard startup.
FROM debian:trixie-20261020@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates git build-essential && rm -rf /var/lib/apt/lists/*
ENV HERMES_RUNTIME_DIR=/opt/hermes/tools CC=gcc CXX=g++
WORKDIR /opt/hermes
COPY *.py pyproject.toml uv.lock ./
COPY agent/ agent/
COPY hermes_agui/ hermes_agui/
COPY hermes_cli/ hermes_cli/
COPY hermes_platform/ hermes_platform/
COPY hermes_agent/ hermes_agent/
COPY providers/ providers/
COPY tools/ tools/
COPY gateway/ gateway/
COPY tui_gateway/ tui_gateway/
COPY cron/ cron/
COPY plugins/ plugins/
COPY pm/ pm/
COPY skills/ skills/
COPY locales/ locales/
COPY scripts/bundles/payload.py scripts/bundles/payload.py
RUN touch README.md
RUN python3 -c 'from pm import ensure; ensure("python", explicit=True); ensure("ripgrep", explicit=True)'
RUN python3 -c 'from pathlib import Path; from pm import installed_package, stage_manager_runtime; from scripts.bundles.payload import seal_pm_runtime; root = Path.cwd(); python = installed_package("python").binary.resolve(); stage_manager_runtime(python=python, destination=root / "pm-runtime", project=root / "pm"); seal_pm_runtime(root, python); Path("/usr/local/bin/hermes-build-python").symlink_to(python)'
RUN hermes-build-python -m pm.build_env --source /opt/hermes \
    --out /opt/hermes/.venv --extra agui --no-install-project --sealed
# Fail the image build if the selected dependency set cannot load native execution.
RUN .venv/bin/python -c 'from run_agent import AIAgent; from hermes_agui.server import create_app; from tools.terminal_tool import terminal_tool'

FROM debian:trixie-20261020@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash git tini libatomic1 libstdc++6 libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --uid 10000 --create-home --home-dir /srv/hermes hermes && \
    mkdir -p /srv/hermes/profile /srv/workspace && \
    chown -R hermes:hermes /srv/hermes /srv/workspace
COPY --from=sqlite_build /opt/sqlite-fixed/lib/libsqlite3.so.3.53.4 /usr/local/lib/
RUN ln -s libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so.0 && ldconfig
COPY --from=build /opt/hermes /opt/hermes
COPY LICENSE /opt/hermes/LICENSE
ENV PATH=/opt/hermes/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HERMES_HOME=/srv/hermes/profile HERMES_RUNTIME_DIR=/opt/hermes/tools \
    PYTHONPATH=/opt/hermes
WORKDIR /opt/hermes
USER 10000:10000
RUN python -c 'import sqlite3; assert sqlite3.sqlite_version_info >= (3, 51, 3); from hermes_agui.server import create_app'
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).close()"]
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "python", "-m", "hermes_agui.server"]
CMD ["--home", "/srv/hermes/profile", "--cwd", "/srv/workspace", "--host", "0.0.0.0", "--port", "8000"]
