{
  "bots": [
    {
      "id": "researcher",
      "agentUrl": "http://127.0.0.1:8000/bots/researcher/agent",
      "tokenEnv": "RESEARCHER_TOKEN"
    },
    {
      "id": "reviewer",
      "agentUrl": "http://127.0.0.1:8000/bots/reviewer/agent",
      "tokenEnv": "REVIEWER_TOKEN"
    }
  ],
  "delegation": {
    "tokenEnv": "DELEGATION_TOKEN",
    "allow": {
      "researcher": [
        "reviewer"
      ],
      "reviewer": [
        "researcher"
      ]
    },
    "listenHost": "0.0.0.0",
    "listenPort": 3001,
    "timeoutMs": 55000
  }
}
