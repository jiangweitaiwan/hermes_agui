# Server-side only. Must match the Hermes AG-UI server's secret.
AGUI_API_KEY=replace-with-a-private-random-token
AGUI_URL=http://127.0.0.1:8000/agent
PORT=3000

# Optional for trusted Graph wiki CLI import. Apply Runtime migrations first.
# AGUI_STORAGE_BACKEND=gcp
# AGUI_RUNTIME_DATABASE_URL=postgresql://runtime@localhost/hermes
# AGUI_GCS_BUCKET=your-private-bucket
