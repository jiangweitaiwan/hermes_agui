# Server-side only. Must match the Hermes AG-UI server's secret.
AGUI_API_KEY=replace-with-a-private-random-token
AGUI_URL=http://127.0.0.1:8000/agent
PORT=3000

# Optional for trusted Graph wiki CLI import. Apply Runtime migrations first.
# AGUI_STORAGE_BACKEND=gcp
# AGUI_RUNTIME_DATABASE_URL=postgresql://runtime@localhost/hermes
# AGUI_GCS_BUCKET=your-private-bucket

# Shared by Host/Runtime. Inject a 32-byte hex seed from secret storage; never store it in registry JSON.
# AGUI_BOT_CREDENTIAL_SEED=replace-with-a-private-64-character-hex-seed
# Authenticated Host completion delivery (storage.graphCompletions=true).
# AGUI_GRAPH_COMPLETION_TOKEN=replace-with-a-private-random-token-of-at-least-32-characters
# Host dispatcher only:
# AGUI_GRAPH_COMPLETION_URL=http://127.0.0.1:3001/internal/graph/completions
