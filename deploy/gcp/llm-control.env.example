# Separate Secret Manager bindings, not browser variables. These are placeholders only.
# Runtime execution identity: SELECT control plane, INSERT immutable run pins.
AGUI_LLM_DATABASE_URL=postgresql://hermes_llm_runtime:PASSWORD@DB_HOST/RUNTIME_DB
# Only the administrative Runtime (and trusted bootstrap CLI) receives this binding.
AGUI_LLM_ADMIN_DATABASE_URL=postgresql://hermes_llm_admin:PASSWORD@DB_HOST/RUNTIME_DB
# Worker: replace AGUI_LLM_DATABASE_URL with hermes_llm_reader; do not mount admin DSN.
# Host: replace AGUI_LLM_DATABASE_URL with hermes_llm_host_reader against RUNTIME_DB.
# Keep AGUI_HOST_DATABASE_URL and existing Host owner privileges unchanged.
# Continue using ADC and existing approved provider Secret Manager/env references.
# No new Vercel secret or public environment variable is needed.
