PORT=8080
AGUI_STORAGE_BACKEND=gcp
AGUI_HOST_DATABASE_URL=postgresql://HOST_ROLE:PASSWORD@/hermes?host=/cloudsql/PROJECT:asia-east1:INSTANCE
AGUI_GCS_BUCKET=YOUR_BUCKET
AGUI_BOT_CREDENTIAL_SEED=REPLACE_WITH_64_HEX_CHARACTERS
AGUI_HOST_MANAGEMENT_TOKEN=REPLACE_WITH_RANDOM_SECRET
OPENROUTER_API_KEY=REPLACE_WITH_SECRET
AGUI_GRAPH_COMPLETION_URL=https://RUNTIME_SERVICE.run.app/internal/graph/completions
AGUI_GRAPH_COMPLETION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AGUI_DELEGATION_TOKEN=REPLACE_WITH_SAME_RANDOM_SECRET_ON_BOTH_SERVICES

# Event-driven completion: enable only on the reviewed new Host revision.
AGUI_COMPLETION_TASKS_ENABLED=false
AGUI_COMPLETION_TASKS_PROJECT=copilotkit-agui
AGUI_COMPLETION_TASKS_LOCATION=asia-east1
AGUI_COMPLETION_TASKS_QUEUE=hermes-completion-delivery
AGUI_COMPLETION_TASKS_HOST_URL=https://HOST_SERVICE.run.app
AGUI_COMPLETION_TASKS_SERVICE_ACCOUNT=DISPATCH_SA@copilotkit-agui.iam.gserviceaccount.com
# AGUI_COMPLETION_TASK_TOKEN: mount Secret Manager fixed numeric version, never plaintext.
# AGUI_GRAPH_COMPLETION_AUDIENCE=https://RUNTIME_SERVICE.run.app
