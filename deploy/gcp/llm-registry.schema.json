{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "providers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "driver": {
                "type": "string",
                "enum": [
                  "openai-compatible"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "keyEnv": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "structured_output",
                    "embedding"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "driver",
              "baseUrl",
              "keyEnv",
              "capabilities"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "driver": {
                "type": "string",
                "enum": [
                  "vertex"
                ]
              },
              "project": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "auth": {
                "type": "string",
                "enum": [
                  "adc"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chat",
                    "structured_output",
                    "embedding"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "driver",
              "project",
              "location",
              "auth",
              "capabilities"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "dimension": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "alias",
          "provider",
          "model",
          "timeoutMs",
          "retries",
          "maxTokens",
          "fallback"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "providers",
    "models"
  ],
  "additionalProperties": false
}
