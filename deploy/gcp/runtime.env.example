PORT=8080
AGUI_BOTS_CONFIG=/app/config/runtime.json
AGUI_STORAGE_BACKEND=gcp
AGUI_RUNTIME_DATABASE_URL=postgresql://RUNTIME_ROLE:PASSWORD@localhost/hermes?host=/cloudsql/PROJECT:asia-east1:INSTANCE
AGUI_GCS_BUCKET=YOUR_BUCKET
AGUI_BOT_CREDENTIAL_SEED=REPLACE_WITH_SAME_64_HEX_CHARACTERS_AS_HOST
AGUI_HOST_MANAGEMENT_TOKEN=REPLACE_WITH_SAME_SECRET_AS_HOST
AGUI_GRAPH_COMPLETION_TOKEN=REPLACE_WITH_SAME_SECRET_AS_HOST
AGUI_WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OPENROUTER_API_KEY=REPLACE_WITH_SECRET
AGUI_DELEGATION_TOKEN=REPLACE_WITH_SAME_RANDOM_SECRET_ON_BOTH_SERVICES
